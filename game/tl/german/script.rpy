# game/script.rpy:41
translate german start_41ed142c:

    # "The chapel is dimly lit by the last traces of daylight."
    "Die letzten Strahlen des Tageslichts scheinen in die Kapelle herein."

# game/script.rpy:45
translate german start_889e4536:

    # maria "It's getting late. I should light the candles."
    maria "Oh, ist es schon so spät? Ich sollte so langsam mal die Kerzen anzünden."

# game/script.rpy:48
translate german start_e3e3adef:

    # "Maria takes a match out of a box."
    "Maria nimmt das erste Streichholz aus der Streichholzschachtel."

# game/script.rpy:50
translate german start_d5df405d:

    # maria "And God said, \"Let there be light.\""
    maria "Und Gott sprach: \"Es werde Licht.\""

# game/script.rpy:56
translate german start_1d0a000a:

    # maria "but the match snapped out of spite..."
    maria "Doch er ahnte nicht, dass mein Streicholz bricht..."

# game/script.rpy:58
translate german start_d40f0fa3:

    # maria "Let me try again."
    maria "Mhm, nächster Versuch."

# game/script.rpy:62
translate german start_b414ce66:

    # "Another match is struck, but it breaks again."
    "Das nächste Streichholz zerbricht wieder, beim Versuch, es anzuzünden."

# game/script.rpy:66
translate german start_667214c1:

    # "And another one."
    "Und dann wieder."

# game/script.rpy:71
translate german start_064563a2:

    # maria "And there was light! ~ Genesis 1:3"
    maria "Und es wurde Licht! ~ Erstes Buch Mose Kapitel 1, Vers 3"

# game/script.rpy:77
translate german start_eec137ea:

    # "Maria looks around the otherwise empty chapel."
    "Marias Blick schweift durch die ansonsten leere Kapelle."

# game/script.rpy:80
translate german start_fcdd4d8e:

    # maria "Though, I doubt we'll be having any visitors tonight."
    maria "Allerdings glaube ich nicht, dass ich heute Abend noch Besuch bekommen werde."

# game/script.rpy:84
translate german start_05562e2e:

    # "She starts lighting another candle."
    "Sie zündet eine weitere Kerze an."

# game/script.rpy:87
translate german start_acd992d5:

    # maria "What is the use of a chapel, without worshipers or visitors?"
    maria "Was ist der Nutzen einer Kapelle, in der es keine Predigten oder Besucher gibt?"

# game/script.rpy:90
translate german start_b36cee6d:

    # maria "A chapel should be a place where people come to find the Lord, after all."
    maria "Eine Kapelle sollte schließlich ein Ort sein, an dem die Menschen den Herrn aufsuchen können."

# game/script.rpy:95
translate german start_f16d4912:

    # "The sound of water droplets can be heard from outside."
    "Das Geräusch von fallenden Regentropfen erklingt von draußen."

# game/script.rpy:98
translate german start_44d8347a:

    # maria "Oh, it's starting to rain! ... again."
    maria "Oh, es fängt an zu regnen! ... Schon wieder."

# game/script.rpy:102
translate german start_dca91aef:

    # maria "Well, that's to be expected from the rainy season."
    maria "Na ja, es ist ja auch immerhin gerade die Regenzeit."

# game/script.rpy:106
translate german start_fb03b67a:

    # maria "The rain falls on the righteous and the unrighteous alike ~ Matthew 5:45"
    maria "Denn er lässt es regnen über Gerechte und Ungerechte. ~ Matthäus Kapitel 5, Vers 45"

# game/script.rpy:108
translate german start_a20cefa7:

    # "..."
    "..."

# game/script.rpy:112
translate german start_b2330b5d:

    # "The rain starts to get heavier, and the sound of water droplets from outside becomes louder."
    "Der Regen wird stärker, und das Prasseln wird immer lauter."

# game/script.rpy:115
translate german start_c6d83883:

    # maria "And apparently, He has decided that we need all of it."
    maria "Und scheinbar hat er beschlossen, dass wir es ziemlich nötig haben."

# game/script.rpy:119
translate german start_563d2e89:

    # "Maria has finished lighting the candles on this spot and walks toward the other side of the chapel."
    "Maria hat alle Kerzen vor ihr angezündet und geht zur einer anderen Stelle in der Kapelle."

# game/script.rpy:123
translate german start_0160e950:

    # maria "Still, I suppose there is a reason this chapel was built here, in the middle of nowhere."
    maria "Trotzdem gab es wohl einen guten Grund, diese Kapelle am Arsch der Welt zu bauen."

# game/script.rpy:126
translate german start_41ad4645:

    # maria "The mountain road can be quite dangerous during the rainy season."
    maria "Die Straßen hier auf dem Berg sind während der Regenzeit ziemlich gefährlich."

# game/script.rpy:129
translate german start_5632ed7b:

    # maria "Travellers caught in the rain sometimes have nowhere else to go."
    maria "Die Reisenden hier haben nicht wirklich viele Alternativen für eine Zuflucht."

# game/script.rpy:132
translate german start_8fdac6df:

    # maria "And a warm dry chapel is certainly better than a cold chapel!"
    maria "Und eine warme, trockene Kapelle ist sicherlich besser als eine nasse und kalte!"

# game/script.rpy:135
translate german start_59f1e0f6:

    # maria "Actually there used to be a lot of accidents here during the rainy season, at least that's what my grandfather used to tell me."
    maria "Früher gab es hier während der Regenzeit viele Unfälle. Zumindest hat mein Großvater mir das immer erzählt."

# game/script.rpy:138
translate german start_a0ea4e2c:

    # maria "Apparently, my great-great-grandfather helped build this chapel for that reason, and supposedly, there have not been any serious accidents since then."
    maria "Angeblich war mein Ururgroßvater sogar am Bau dieser Kapelle beteiligt. Und seit dem soll es keine schlimmen Unfälle mehr gegeben haben."

# game/script.rpy:142
translate german start_cd580f74:

    # maria "Before you were born, I set you apart for my holy purpose. ~ Jeremiah 1:5"
    maria "Und ehe du geboren wurdest, habe ich dich erwählt, um mir allein zu dienen. ~ Jeremia Kapitel 1, Vers 5"

# game/script.rpy:145
translate german start_d56d7bf4:

    # maria "It's a wonderful feeling, knowing that the Lord's house can offer shelter to those in need."
    maria "Es ist schon schön zu wissen, dass das Haus des Herrn jedem Schutz bieten kann."

# game/script.rpy:148
translate german start_b6f9bcb3:

    # maria "Though most of the time, it only shelters me... from my sister's constant bragging back home."
    maria "Meistens bietet es allerdings nur mir Schutz ... vor dem ständigen Generve meiner Schwester zu Hause."

# game/script.rpy:151
translate german start_4c3f455a:

    # "Maria pauses for a moment, looking at the rain outside."
    "Maria hält einen Moment inne und betrachtet den Regen."

# game/script.rpy:154
translate german start_30629322:

    # maria "I wonder how my sister Camilla is doing in Willowe."
    maria "Ich frage mich, wie es meiner Schwester Kamilla geht."

# game/script.rpy:157
translate german start_e3593a9b:

    # maria "She is probably busy with her potion shop. She always is."
    maria "Wahrscheinlich hat sie mal wieder alle Hände voll zu tun, mit ihrem Heiltrankladen. Wie immer."

# game/script.rpy:160
translate german start_d5b3ad27:

    # maria "Unlike some other people, who get sent to the middle of nowhere to take care of a chapel."
    maria "Anders als gewisse andere Leute, die ans Ende der Welt geschickt werden, um auf eine Kapelle aufzupassen."

# game/script.rpy:163
translate german start_f63fe8b6:

    # "Maria shakes her head and smiles."
    "Maria schüttelt den Kopf und schmunzelt."

# game/script.rpy:166
translate german start_17f60f53:

    # maria "But I shouldn't complain. The Lord has chosen this path for me, and I should walk it faithfully."
    maria "Aber ich sollte nicht so viel meckern. Der Herr hat diesen Weg für mich ausgewählt, also werde ich ihn auch gehen."

# game/script.rpy:169
translate german start_bc26c177:

    # maria "Though I do wish the path had a few more people on it..."
    maria "Auch wenn ich mir wünschte, dass ein paar mehr Menschen auf diesem Weg unterwegs wären ..."

# game/script.rpy:174
translate german start_1f4d85a8:

    # "The rain is getting even more intense outside."
    "Der Regen wird immer heftiger."

# game/script.rpy:177
translate german start_a34402c8:

    # maria "Ohh, sounds like someone didn't finish their dinner yesterday!"
    maria "Oh, klingt als hätte jemand seinen Teller nicht aufgegessen!"

# game/script.rpy:180
translate german start_66e2ed5c:

    # maria "At least, that's something my parents used to say: 'If you don't eat up, there will be bad weather tomorrow.'"
    maria "Zumindest haben meine Eltern das immer gesagt: 'Wenn du nicht aufisst, dann gibt es morgen schlechtes Wetter.'"

# game/script.rpy:183
translate german start_0afd0663:

    # maria "Well, it's not going to stop anytime soon. Just like a soul that doesn't know Jesus, wandering around until damnation."
    maria "So schnell wird das mit dem Regen wohl nicht mehr aufhören. Genau wie eine Seele ohne Jesus, die umherirrt bis zur Verdammnis."

# game/script.rpy:187
translate german start_649a52e2:

    # "Maria walks over to light another candle, briefly turning her back to the window."
    "Maria macht sich auf den Weg zu einer weiteren Kerze, und kehrt dem Fenster kurz den Rücken zu."

# game/script.rpy:190
translate german start_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:279
translate german window_scene_c8f0e155:

    # "The raindrops gently patter against the chapel window, playing a soothing melody."
    "Die Regentropfen prasseln gegen die Fenster und spielen dabei eine gleichmäßige Melodie."

# game/script.rpy:287
translate german window_scene_56b76523:

    # "A sudden strike of lighting illuminates the scene."
    "Ein heller Blitz erscheint."

# game/script.rpy:292
translate german window_scene_136ca317:

    # "And for a brief moment, something appears right behind the window."
    "Und für einen kurzen Moment kann man etwas direkt hinter dem Fenster erblicken."

# game/script.rpy:296
translate german window_scene_a14714db:

    # "The sound of shattering glass echoes through the chapel and Maria turns around in shock."
    "Das Geräusch von brechendem Glas hallt durch die Kapelle, und Maria erschrickt."

# game/script.rpy:304
translate german window_scene_33005d36:

    # nana "Ouch, ouch, ouch! Oh no, potato salad! Are you alright?!"
    nana "Au, au, au! Oh nein, Kartoffelsalat! Geht es dir gut?!"

# game/script.rpy:307
translate german window_scene_9e2f0bd9:

    # "Nana reaches out to the broom."
    "Nana greift nach dem Besen."

# game/script.rpy:321
translate german maria_menu_potato_salad_b9b53f8f:

    # maria "Potato salad?"
    maria "Kartoffelsalat?"

# game/script.rpy:324
translate german maria_menu_potato_salad_9906a950:

    # "Nana is still examining the broom, and does not appear to have heard Maria's question."
    "Nanas Aufmerksamkeit liegt komplett bei dem Besen. Sie scheint Marias Frage gar nicht zu hören."

# game/script.rpy:328
translate german maria_menu_potato_salad_03690bc1:

    # nana "Oh, thank goodness! You're alright!"
    nana "Oh, Gott sei Dank! Es geht dir gut!"

# game/script.rpy:331
translate german maria_menu_potato_salad_aefd9bd4:

    # "Nana gives the broom a little hug before finally noticing Maria."
    "Nana gibt dem Besen eine kleine Umarmung, bevor sie dann doch noch Maria bemerkt."

# game/script.rpy:335
translate german maria_menu_potato_salad_964cfe2e:

    # "The broom makes a small rustling sound when Nana picks it up."
    "Der Besen raschelt leise, während Nana ihn umarmt."

# game/script.rpy:337
translate german maria_menu_potato_salad_a20cefa7:

    # "..."
    "..."

# game/script.rpy:340
translate german maria_menu_potato_salad_c71b634e:

    # nana "Oh! Um, sorry! I didn't notice you! Did you say something?"
    nana "Oh! Ähm, entschuldigung! Ich habe dich nicht gesehen! Hast du was gesagt?"

# game/script.rpy:343
translate german maria_menu_potato_salad_98f310fc:

    # maria "Potato salad? Pray tell, is that the name of the broom?"
    maria "Kartoffelsalat? Ist das der Name von deinem Besen?"

# game/script.rpy:346
translate german maria_menu_potato_salad_4752af81:

    # nana "Oh, yes! This is potato salad! And it's, um... just a normal broom. Nothing special!"
    nana "Oh, ja! Kartoffelsalat! Er ist, ähm ... nur ein ganz normaler Besen. Nichts Verdächtiges!"

# game/script.rpy:351
translate german maria_menu_potato_salad_0d722dc9:

    # "Nana seems to be hiding something, but she is trying her best to act normal."
    "Nana scheint etwas zu verbergen. Sie versucht es aber krampfhaft zu verstecken."

# game/script.rpy:353
translate german maria_menu_potato_salad_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:356
translate german maria_menu_potato_salad_5ea550e7:

    # maria "It is an awfully peculiar name for something so ordinary."
    maria "Das ist aber ein ziemlich verdächtiger Name für einen unverdächtigen Besen."

# game/script.rpy:360
translate german maria_menu_potato_salad_253e47e7:

    # nana "Well, I suppose it is a bit peculiar."
    nana "Naja, vielleicht ein ganz klein wenig verdächtig."

# game/script.rpy:363
translate german maria_menu_potato_salad_a7bd5531:

    # nana "I named it after my favorite food!"
    nana "Ich hab' ihn nach meinem Lieblingsessen benannt!"

# game/script.rpy:366
translate german maria_menu_potato_salad_ace8d94a:

    # "Nana looks at Maria with a smile and wide eyes, as if she is awaiting a compliment."
    "Nana sieht Maria lächelnd und mit großen Augen an, als würde sie auf Lob warten."

# game/script.rpy:369
translate german maria_menu_potato_salad_2c864db0:

    # "Maria decides not to comment."
    "Maria bleibt still."

# game/script.rpy:372
translate german maria_menu_potato_salad_b3865f67:

    # nana "His first name is Potato, and his last name is Salad!"
    nana "Sein Vorname ist Kartoffel und sein Nachname ist Salat!"

# game/script.rpy:376
translate german maria_menu_potato_salad_396c63d7:

    # "Maria closes her eyes to relax for a moment, and then opens them again."
    "Maria schließt kurz die Augen, um sich zu beruhigen."

# game/script.rpy:383
translate german maria_menu_charisma1_1e732413:

    # maria "I suppose the door was too difficult to find?"
    maria "War die Tür zu schwer zu finden?"

# game/script.rpy:386
translate german maria_menu_charisma1_4654817d:

    # nana "Oh! I... well..."
    nana "Oh! Ich ... ähm..."

# game/script.rpy:390
translate german maria_menu_charisma1_351aa1f8:

    # "Nana pauses for a moment, before realizing that Maria was making a joke."
    "Nana überlegt für einen kurzen Moment, bis ihr klar wird, dass Maria einen Witz gemacht hat."

# game/script.rpy:393
translate german maria_menu_charisma1_adeecb8c:

    # nana "Oh! Haha! Yes, I suppose it was!"
    nana "Oh! Haha! Ja, das war sie wohl!"

# game/script.rpy:397
translate german maria_menu_charisma1_5ae43a50:

    # nana "You know, you can always come in through the door, but you can only come in through the window once!"
    nana "Weißt du, durch die Tür kann man immer kommen, aber durch das Fenster halt nur ein mal!"

# game/script.rpy:400
translate german maria_menu_charisma1_859cbc1b:

    # "Maria is waiting for the punchline."
    "Maria wartet auf die Pointe."

# game/script.rpy:403
translate german maria_menu_charisma1_1e798a6a:

    # nana "Because it will be broken after that..."
    nana "Weil es danach kaputt ist..."

# game/script.rpy:407
translate german maria_menu_charisma1_6a1faacd:

    # "Maria manages to force a small smile, mostly out of politeness."
    "Maria zeigt ein kleines Lächeln, hauptsächlich aus Höflichkeit."

# game/script.rpy:410
translate german maria_menu_charisma1_9d1dbf42:

    # "Nana is thinking about Maria's question, but she doesn't seem to understand the joke."
    "Nana denkt über Marias Frage nach, aber leider vergeblich."

# game/script.rpy:413
translate german maria_menu_charisma1_ae147dfa:

    # nana "Oh! The door? I think it should be... right over there!"
    nana "Oh! Die Tür? Ich glaube, sie müsste ... da sein!"

# game/script.rpy:416
translate german maria_menu_charisma1_86e124a6:

    # maria "..."
    maria "..."

# game/script.rpy:418
translate german maria_menu_charisma1_cbbb44b1:

    # nana "Why are you asking?"
    nana "Warum fragst du?"

# game/script.rpy:421
translate german maria_menu_charisma1_49e280a4:

    # nana "Wait, how did you even get in without the door? Did you also crash into a window?"
    nana "Moment, wie bist du denn dann hier reingekommen? Bist du auch durch ein Fenster geflogen?"

# game/script.rpy:424
translate german maria_menu_charisma1_31bbf3c1:

    # maria "Never mind, forget I asked."
    maria "Egal, vergiss einfach, dass ich gefragt habe."

# game/script.rpy:430
translate german scene2_6538a7af:

    # nana "Wait, let me get up!"
    nana "Warte, lass mich erstmal aufstehen!"

# game/script.rpy:437
translate german scene_maria_introduces_herself_ed7f28af:

    # nana "I am sorry Sister, I didn't mean to intrude like that!"
    nana "Entschuldigung, Schwester, ich wollte nicht so hereinplatzen!"

# game/script.rpy:441
translate german scene_maria_introduces_herself_6bfe3bc5:

    # "Maria's eye twitches slightly at the word 'Sister'."
    "Marias Auge zuckt leicht beim Wort „Schwester“."

# game/script.rpy:443
translate german scene_maria_introduces_herself_a20cefa7:

    # "..."
    "..."

# game/script.rpy:445
translate german scene_maria_introduces_herself_5f0cdcc7:

    # maria "Oh, please. Just call me Maria."
    maria "Ach bitte. Nenn mich einfach Maria."

# game/script.rpy:448
translate german scene_maria_introduces_herself_cf37eab2:

    # nana "So- sorry Sister! I mean, Maria!"
    nana "Ent-schuldigung, Schwester! Ich meine, Maria!"

# game/script.rpy:451
translate german scene_maria_introduces_herself_e4b09337:

    # nana "But you are a Sister, right? I mean a follower of the church."
    nana "Aber du bist doch eine Schwester, oder? Ich meine, du gehörst zur Kirche?"

# game/script.rpy:455
translate german scene_maria_introduces_herself_2d01de99:

    # maria "We are all brothers and sisters of Jesus."
    maria "Wir sind alle Brüder und Schwestern von Jesus."

# game/script.rpy:460
translate german scene_maria_introduces_herself_8a1637c4:

    # maria "The Spirit himself testifies that we are God's children. ~ Romans 8:16"
    maria "Der Heilige Geist sagt selber, dass wir Kinder Gottes sind. ~ Römer 8,16"

# game/script.rpy:462
translate german scene_maria_introduces_herself_a20cefa7_1:

    # "..."
    "..."

# game/script.rpy:465
translate german scene_maria_introduces_herself_5d02134c:

    # maria "But yes, though I am actually the appointed priestess of this chapel."
    maria "Aber ja, ich bin tatsächlich die zuständige Priesterin dieser Kapelle."

# game/script.rpy:469
translate german scene_maria_introduces_herself_5bf4dba0:

    # nana "I see! Sister Maria, that is impressive!"
    nana "Verstehe! Sehr beeindruckent Schwester Maria!"

# game/script.rpy:472
translate german scene_maria_introduces_herself_04c928ad:

    # maria "Like I said, just Maria is fine."
    maria "Wie gesagt, Maria reicht aus."

# game/script.rpy:476
translate german scene_maria_introduces_herself_8b979557:

    # "It appears that Maria is slowly losing her patience."
    "Maria verliert so langsam die Geduld."

# game/script.rpy:478
translate german scene_maria_introduces_herself_a20cefa7_2:

    # "..."
    "..."

# game/script.rpy:482
translate german scene_maria_introduces_herself_7adc9025:

    # maria "The youngest daughter of my parents already calls me sister, and I don't need anyone else to call me that."
    maria "Die jüngste Tochter meiner Eltern nennt mich schon die ganze Zeit Schwester. Das reicht dann auch."

# game/script.rpy:486
translate german scene_maria_introduces_herself_44a93fc9:

    # nana "Um, Oh! You have a younger sister? I see! That is wonderful!"
    nana "Ähm, oh! Du hast eine jüngere Schwester? Das ist ja toll!"

# game/script.rpy:488
translate german scene_maria_introduces_herself_f54cb39a:

    # maria "Yes, wonderful indeed. Bless the Lord!"
    maria "Ja, ganz toll. Gelobt sei der Herr!"

# game/script.rpy:491
translate german scene_maria_introduces_herself_528ec34f:

    # "This remark sounded a bit sarcastic."
    "Diese Bemerkung klang etwas sarkastisch."

# game/script.rpy:493
translate german scene_maria_introduces_herself_a20cefa7_3:

    # "..."
    "..."

# game/script.rpy:496
translate german scene_maria_introduces_herself_7b667230:

    # nana "Um, what?"
    nana "Ähm, was?"

# game/script.rpy:498
translate german scene_maria_introduces_herself_a6541976:

    # maria "Forget it, just call me Maria."
    maria "Vergiss es, nenn mich einfach Maria."

# game/script.rpy:505
translate german scene_maria_introduces_herself_81f3c00e:

    # "The raindrops continue to patter against the remaining chapel windows."
    "Die Regentropfen prasseln weiterhin gegen die übrigen Fenster."

# game/script.rpy:508
translate german scene_maria_introduces_herself_92252bb4:

    # "A howling gust of wind rushes through the broken window."
    "Eine heulender Wind weht durch das zerbrochene Fenster."

# game/script.rpy:516
translate german scene_nana_introduces_herself_654b9885:

    # nana "Nana."
    nana "Nana."

# game/script.rpy:519
